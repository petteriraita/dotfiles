#!/usr/bin/env bash
# One normal systemd suspend cycle, observed by the installed AMD sleep hook.
set -euo pipefail
[[ $EUID -eq 0 && $# -eq 1 ]] || exit 1
report_dir="$1"
tool_env=/home/pt/.local/share/amd-debug-tools/.venv-system
test -x /usr/lib/systemd/system-sleep/s2idle-hook
[[ "$(uname -r)" == 7.2.11-100.fc43.x86_64 ]] || {
    echo 'Reboot into the installed 7.2.11 kernel before this comparison test.'
    exit 1
}
echo 'Rechecking prerequisites under the new kernel before scheduling sleep.'
"$tool_env/bin/python" /home/pt/dev/config/dotfiles/bin/amd-sleep-prerequisites.py "$report_dir"
# Avoid replacing a wake alarm scheduled by something else.
alarm="$(cat /sys/class/rtc/rtc0/wakealarm)"
[[ -z "$alarm" || "$alarm" == 0 ]] || {
    echo "An RTC wake alarm is already scheduled ($alarm); leaving it alone."
    exit 1
}
started="$(date --iso-8601=seconds)"
printf 'kernel=%s\nstarted=%s\n' "$(uname -r)" "$started" > "$report_dir/test-context.txt"
cat /proc/sys/kernel/random/boot_id >> "$report_dir/test-context.txt"
journalctl --sync
rtcwake -m no -s 20
trap 'rtcwake -m disable >/dev/null 2>&1 || true' EXIT
echo 'Suspending once; an RTC alarm requests wake-up after about 20 seconds.'
status=0
systemctl suspend || status=$?
echo "Suspend command returned: $status"
if (( status == 0 )); then
    # systemctl suspend queues sleep and may return before the sleep hooks start.
    # This process is frozen during sleep. Wait for the matching service to
    # finish before clearing the wake alarm or exporting diagnostics.
    completed=0
    for ((attempt = 0; attempt < 120; attempt++)); do
        events="$(journalctl -b -u systemd-suspend.service --since "$started" --no-pager -o cat)"
        if [[ "$events" == *"Finished systemd-suspend.service"* ]]; then
            completed=1
            break
        fi
        if [[ "$events" == *"Failed to start systemd-suspend.service"* || "$events" == *"Failed with result"* ]]; then
            echo 'The suspend service failed.'
            status=1
            break
        fi
        sleep 1
    done
    if (( ! completed && status == 0 )); then
        echo 'No completed suspend cycle was recorded; result is inconclusive.'
        status=1
    fi
fi
rtcwake -m disable || true
journalctl -b -k --since "$started" --no-pager > "$report_dir/kernel.txt"
"$tool_env/bin/amd-s2idle" report --since "$started" \
    --until "$(date --iso-8601=seconds)" --format txt --report-debug \
    --report-file "$report_dir/amd-report.txt" || status=$?
if [[ -n "${SUDO_UID:-}" ]]; then
    for name in test-context.txt kernel.txt amd-report.txt; do
        if [[ -f "$report_dir/$name" ]]; then
            chmod 0600 "$report_dir/$name"
            chown "$SUDO_UID:$SUDO_GID" "$report_dir/$name"
        fi
    done
fi
exit "$status"
