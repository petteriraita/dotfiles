[Unit]
Description=Local Terraforming Mars statistics dashboard
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pt/dev/personal/apps/terraforming-mars/mars-stats
Environment=HOST=127.0.0.1
Environment=PORT=8080
ExecStart=/home/pt/dev/personal/apps/terraforming-mars/mars-stats/.venv/bin/python /home/pt/dev/personal/apps/terraforming-mars/mars-stats/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
