[Unit]
Description=Capture diagnostics around X11 desktop freezes
After=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%t/gdm/Xauthority
ExecStart=%h/dev/config/dotfiles/bin/freeze-monitor.sh
Restart=always
RestartSec=3
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
